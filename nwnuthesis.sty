%---------------------------------------------------------------------------%
%  6. 章节格式（titlesec）与内部命令
%---------------------------------------------------------------------------%
\makeatletter

\def\@chapter[#1]#2{\ifnum \c@secnumdepth >\m@ne
  \if@mainmatter
  \refstepcounter{chapter}%
  \typeout{\@chapapp\space\thechapter.}%
  \addcontentsline{toc}{chapter}%
  {\protect\numberline{\thechapter}#1}%
  \def\leftmark{第\thechapter 章\quad #2}
  \else
  \addcontentsline{toc}{chapter}{#1}%
  \fi
  \else
  \addcontentsline{toc}{chapter}{#1}%
  \fi
  \chaptermark{#1}%
  \if@twocolumn
  \@topnewpage[\@makechapterhead{#2}]%
  \else
  \@makechapterhead{#2}%
  \@afterheading
\fi}

\def\@schapter#1{\if@twocolumn
  \@topnewpage[\@makeschapterhead{#1}]%
  \else
  \@makeschapterhead{#1}%
  \def\leftmark{#1}
  \@afterheading
  \fi
  % 无编号章自动写入目录（目录/清单内部调用时由标志位跳过）
  \ifnwnuSchapterToc
  \addcontentsline{toc}{chapter}{#1}%
\fi}
\makeatother

\setcounter{secnumdepth}{4}
\setlength{\parindent}{2em}
\renewcommand{\chaptername}{\prechaptername\arabic{chapter}\postchaptername}

\titleformat{\chapter}{\centering\sanhao\hei}{\chaptername}{1em}{}
\titlespacing{\chapter}{0pt}{-10pt}{18pt}
\titleformat{\section}{\sihao\hei}{\thesection}{1em}{}
\titlespacing{\section}{0pt}{20pt}{8pt}
\titleformat{\subsection}{\sihao\hei}{\thesubsection}{1em}{}
\titlespacing{\subsection}{0pt}{20pt}{8pt}
\titleformat{\subsubsection}{\xiaosi\hei}{\thesubsubsection}{0.5em}{}
\titlespacing{\subsubsection}{0pt}{6pt}{6pt}

