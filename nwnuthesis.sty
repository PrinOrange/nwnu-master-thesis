%===========================================================================%
%  nwnuthesis.sty
%  西北师范大学硕士学位论文（专业学位）统一样式包
%
%  本文件整合了原模板中的三处样式来源：
%    - setup/package.tex    （宏包加载与字体映射）
%    - setup/format.tex     （格式规则、自定义宏、封面排版）
%    - main.tex 中的页眉页脚与页面样式定义
%  并清理了重复加载、死代码与拼写错误。
%
%  使用方式：
%    \documentclass[a4paper,12pt,openany,twoside]{book}
%    \usepackage{nwnuthesis}
%
%  编译方式：XeLaTeX（依赖 ctex/xeCJK，中文字体为 Windows 系统字体）
%===========================================================================%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nwnuthesis}[2026/08/27 v1.0 NWNU thesis
(professional degree) style]

%---------------------------------------------------------------------------%
%  1. 宏包加载
%---------------------------------------------------------------------------%

% 中文字体支持（必须在 \setCJKfamilyfont 之前加载）
\RequirePackage{ctex}

% 西文字体：fontspec 必须在 newtxmath 之前加载；不要加载 newtxtext，
% 它和 fontspec 冲突会导致 SimSun 等中文字体解析失败。
\RequirePackage{fontspec}
\setmainfont{Times New Roman}

% 将自定义 CJK 字体族（\song/\hei/\kai/\fs/\li/\FSGB 即 \CJKfamily{...}）
% 映射到 Windows 系统字体
\setCJKfamilyfont{song}{SimSun}
\setCJKfamilyfont{hei}{SimHei}
\setCJKfamilyfont{kai}{KaiTi}
\setCJKfamilyfont{fs}{FangSong}
\setCJKfamilyfont{li}{LiSu}
\setCJKfamilyfont{FSGB}{FangSong}

% 页面几何
\RequirePackage{geometry}
\geometry{left=3.0cm,right=3.0cm,top=3.0cm,bottom=3.0cm}

% 标题与目录
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage[titles,subfigure]{tocloft}
\RequirePackage{caption}

% 页眉页脚
\RequirePackage{fancyhdr}

% 数学（newtxmath 必须晚于 fontspec/\setmainfont）
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{newtxmath}
\RequirePackage{bm}

% 图表与算法
\RequirePackage{graphicx}
\RequirePackage{enumerate}
\RequirePackage{multirow}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{subfigure}
\RequirePackage[subfigure]{ccaption}
\RequirePackage[below]{placeins}
\RequirePackage{flafter}
\RequirePackage[chapter]{algorithm}
\RequirePackage{algorithmic}

% 列表、段落、版面
\RequirePackage{enumitem}
\RequirePackage{setspace}
\RequirePackage{indentfirst}
\RequirePackage{ragged2e}
\RequirePackage{calc}
\RequirePackage{layout}
\RequirePackage{lastpage}

% 颜色与引用
\RequirePackage{color}
\RequirePackage{cite}
\RequirePackage[sort&compress,numbers]{natbib}
\RequirePackage{url}

% 定理类环境
\RequirePackage[amsmath,thmmarks,hyperref]{ntheorem}

% hyperref（最后加载，避免与其它宏包冲突）
\RequirePackage[unicode,
  pdfstartview=FitH,
  bookmarksnumbered=true,
  bookmarksopen=true,
  colorlinks=true,
  pdfborder={0 0 1},
  citecolor=black,
  linkcolor=black,
  anchorcolor=black,
  urlcolor=black,
  breaklinks=true
]{hyperref}

% 算法题注字体
\DeclareCaptionFont{myfont}{\fontsize{10.5pt}{10.5pt}\selectfont}
\captionsetup[algorithm]{font=myfont}

% 公式编号与编号标签格式（中文全角括号）
\renewcommand{\theequation}{\arabic{chapter}-\arabic{equation}}
\makeatletter
\def\tagform@#1{\maketag@@@{（\ignorespaces#1\unskip）}}
\makeatother

